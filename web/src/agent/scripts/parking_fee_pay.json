{
  "id": "parking_fee_pay",
  "description": "繳納路邊停車費",
  "slots": {
    "vehicle": { "ask": "請問是汽車還是機車？", "options": ["汽車", "機車"] },
    "plate": { "ask": "請說車號，例如 ABC 1234。", "label": "車號", "pattern": "^[A-Z0-9]{2,4}-[A-Z0-9]{2,4}$" },
    "method": {
      "ask": "請問要用悠遊付、台北富邦信用卡，還是智慧支付平台繳費？",
      "options": ["悠遊付", "台北富邦信用卡", "智慧支付平台"]
    }
  },
  "steps": [
    { "open": "https://taipei-pass-service.vercel.app/fee-payment/detail/fee-5/" },
    { "say": "正在幫您繳費" },
    { "click": { "text": "{vehicle}" } },
    { "fill": { "near": "AAA-8888", "value": "{plate}" } },
    { "click": { "text": "查詢" } },
    { "wait": { "text": "選擇帳單" } },
    { "click": { "text": "全部繳清" }, "say": "選擇全部帳單" },
    { "click": { "text": "前往繳費" } },
    { "click": { "text": "{method}" }, "say": "選擇{method}" },
    { "wait": { "text": "您即將進入支付業者付款頁面" } },
    { "click": { "text": "是" }, "say": "確認付款" },
    { "wait": { "text": "繳費完成" } },
    { "read": { "selector": "ul", "pairs": true, "as": "receipt" } },
    { "stop": "繳費完成。" }
  ]
}
