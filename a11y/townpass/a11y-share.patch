+import 'package:flutter/material.dart';
+import 'package:town_pass/service/a11y_share_service.dart';
+
+/// 包住整個 App（main.dart 的 `builder`），讓無障礙輔助「讓家人幫忙」能拍下台北通的畫面。
+///
+/// 沒有分享時和原本一樣，只多一層 RepaintBoundary。分享時：
+/// - 畫面下方出現「王小美 正在看你的畫面」與「停止分享」（不會被拍進去，也不會被家人按到）
+/// - 家人點的位置畫一個圈
+/// - 家人要按重要按鈕時，蓋上一層問「同意嗎？」（家人看不到也按不到）
+class A11yShareScope extends StatelessWidget {
+  final Widget child;
+
+  const A11yShareScope({super.key, required this.child});
+
+  @override
+  Widget build(BuildContext context) {
+    final A11yShareService service = A11yShareService.instance;
+    return ValueListenableBuilder<A11yShareSession?>(
+      valueListenable: service.session,
+      child: RepaintBoundary(key: service.boundaryKey, child: child),
+      builder: (context, session, app) {
+        // 結構不管有沒有分享都一樣，App 的頁面才不會被重建
+        return Stack(
+          fit: StackFit.expand,
+          children: [
+            Column(
+              children: [
+                Expanded(
+                  child: MediaQuery.removePadding(
+                    context: context,
+                    removeBottom: session != null, // 下方的安全區域改由提示列使用
+                    child: app!,
+                  ),
+                ),
+                if (session != null) _SharingBar(session: session),
+              ],
+            ),
+            if (session != null) ...[
+              ValueListenableBuilder<Offset?>(
+                valueListenable: service.highlight,
+                builder: (context, point, _) => switch (point) {
+                  Offset point => Positioned(
+                      left: point.dx - 28,
+                      top: point.dy - 28,
+                      child: const IgnorePointer(child: _TapRing()),
+                    ),
+                  null => const Positioned(left: 0, top: 0, child: SizedBox.shrink()),
+                },
+              ),
+              ValueListenableBuilder<A11yShareQuestion?>(
+                valueListenable: service.question,
+                builder: (context, question, _) => switch (question) {
+                  A11yShareQuestion question => Positioned.fill(child: _QuestionCard(question: question)),
+                  null => const Positioned(left: 0, top: 0, child: SizedBox.shrink()),
+                },
+              ),
+            ],
+          ],
+        );
+      },
+    );
+  }
+}
+
+const Color _barColor = Color(0xFFFFE08A);
+const Color _barText = Color(0xFF3A2E00);
+const Color _danger = Color(0xFFB3261E);
+const Color _brand = Color(0xFF2F6A75);
+
+class _SharingBar extends StatelessWidget {
+  final A11yShareSession session;
+
+  const _SharingBar({required this.session});
+
+  @override
+  Widget build(BuildContext context) {
+    return Material(
+      color: _barColor,
+      child: SafeArea(
+        top: false,
+        child: Padding(
+          padding: const EdgeInsets.fromLTRB(16, 10, 12, 10),
+          child: Row(
+            children: [
+              Container(
+                width: 12,
+                height: 12,
+                decoration: const BoxDecoration(color: _danger, shape: BoxShape.circle),
+              ),
+              const SizedBox(width: 10),
+              Expanded(
+                child: Text(
+                  '${session.caregiverName} 正在看你的畫面',
+                  style: const TextStyle(fontSize: 18, fontWeight: FontWeight.w700, color: _barText),
+                ),
+              ),
+              const SizedBox(width: 8),
+              FilledButton(
+                onPressed: A11yShareService.instance.confirmStop,
+                style: FilledButton.styleFrom(
+                  backgroundColor: _danger,
+                  minimumSize: const Size(96, 48),
+                  textStyle: const TextStyle(fontSize: 18, fontWeight: FontWeight.w700),
+                ),
+                child: const Text('停止分享'),
+              ),
+            ],
+          ),
+        ),
+      ),
+    );
+  }
+}
+
+class _TapRing extends StatelessWidget {
+  const _TapRing();
+
+  @override
+  Widget build(BuildContext context) {
+    return Container(
+      width: 56,
+      height: 56,
+      decoration: BoxDecoration(
+        shape: BoxShape.circle,
+        border: Border.all(color: const Color(0xFFFFB300), width: 4),
+        color: const Color(0x33FFB300),
+      ),
+    );
+  }
+}
+
+class _QuestionCard extends StatelessWidget {
+  final A11yShareQuestion question;
+
+  const _QuestionCard({required this.question});
+
+  @override
+  Widget build(BuildContext context) {
+    // BlockSemantics：螢幕閱讀器只讀這個問題，不會讀到後面的畫面
+    return BlockSemantics(
+      child: Material(
+        color: Colors.black54,
+        child: SafeArea(
+          child: Center(
+            child: Container(
+              margin: const EdgeInsets.all(24),
+              padding: const EdgeInsets.all(24),
+              decoration: BoxDecoration(color: Colors.white, borderRadius: BorderRadius.circular(12)),
+              child: Column(
+                mainAxisSize: MainAxisSize.min,
+                crossAxisAlignment: CrossAxisAlignment.stretch,
+                children: [
+                  Semantics(
+                    header: true,
+                    liveRegion: true,
+                    child: Text(
+                      question.title,
+                      style: const TextStyle(fontSize: 22, fontWeight: FontWeight.w700, height: 1.4),
+                    ),
+                  ),
+                  const SizedBox(height: 20),
+                  FilledButton(
+                    onPressed: () => question.answer(true),
+                    style: FilledButton.styleFrom(
+                      backgroundColor: _brand,
+                      minimumSize: const Size.fromHeight(56),
+                      textStyle: const TextStyle(fontSize: 20, fontWeight: FontWeight.w700),
+                    ),
+                    child: Text(question.acceptLabel),
+                  ),
+                  const SizedBox(height: 12),
+                  OutlinedButton(
+                    onPressed: () => question.answer(false),
+                    style: OutlinedButton.styleFrom(
+                      foregroundColor: _brand,
+                      minimumSize: const Size.fromHeight(56),
+                      textStyle: const TextStyle(fontSize: 20, fontWeight: FontWeight.w700),
+                    ),
+                    child: Text(question.rejectLabel),
+                  ),
+                ],
+              ),
+            ),
+          ),
+        ),
+      ),
+    );
+  }
+}
