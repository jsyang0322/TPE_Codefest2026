diff --git a/lib/service/a11y_share_service.dart b/lib/service/a11y_share_service.dart
new file mode 100644
index 0000000..005f1e0
--- /dev/null
+++ b/lib/service/a11y_share_service.dart
@@ -0,0 +1,51 @@
+import 'dart:collection';
+
+import 'package:flutter_inappwebview/flutter_inappwebview.dart';
+
+/// 無障礙輔助「讓家人幫忙」：分享開始後，之後打開的每個服務網頁都放入分享程式，
+/// 照顧者就能看到同一個畫面，也能幫忙點按、填寫。
+///
+/// 分享程式（開源的 rrweb 錄製程式＋分享程式）由無障礙輔助的網頁組好後交給 App，
+/// App 只負責保存與放入網頁，所以更新分享程式不需要重新安裝 App。
+/// 程式碼在 TPE_Codefest2026 的 a11y/frontend/js/share-agent.js。
+class A11yShareService {
+  A11yShareService._();
+
+  static final A11yShareService instance = A11yShareService._();
+
+  /// 無障礙輔助網頁的網址。執行時可以指定：
+  /// `fvm flutter run --dart-define=A11Y_URL=https://你的網址/`
+  static const String serviceUrl = String.fromEnvironment(
+    'A11Y_URL',
+    defaultValue: 'https://a11y.invalid/',
+  );
+
+  String? _script;
+
+  bool get active => _script != null;
+
+  /// 只接受無障礙輔助網頁送來的分享程式：其他網頁不能要求 App 把程式放進別的網頁。
+  bool isTrustedOrigin(WebUri? origin) {
+    final Uri allowed = Uri.parse(serviceUrl);
+    if (origin == null || origin.scheme != allowed.scheme || origin.host != allowed.host) {
+      return false;
+    }
+    return !allowed.hasPort || origin.port == allowed.port;
+  }
+
+  void start(String script) => _script = script;
+
+  void stop() => _script = null;
+
+  /// 交給 TPWebView 的 initialUserScripts。沒有在分享時回傳 null，網頁和原本完全一樣。
+  UnmodifiableListView<UserScript>? get userScripts => switch (_script) {
+        String script => UnmodifiableListView<UserScript>([
+            UserScript(
+              source: script,
+              injectionTime: UserScriptInjectionTime.AT_DOCUMENT_END,
+              forMainFrameOnly: true,
+            ),
+          ]),
+        null => null,
+      };
+}
