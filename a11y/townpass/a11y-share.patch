diff --git a/lib/util/web_message_handler/a11y_share_message_handler.dart b/lib/util/web_message_handler/a11y_share_message_handler.dart
new file mode 100644
index 0000000..2993b1c
--- /dev/null
+++ b/lib/util/web_message_handler/a11y_share_message_handler.dart
@@ -0,0 +1,45 @@
+import 'package:flutter_inappwebview/flutter_inappwebview.dart';
+import 'package:town_pass/service/a11y_share_service.dart';
+import 'package:town_pass/util/web_message_handler/tp_web_message_handler.dart';
+
+/// 無障礙輔助網頁開始分享畫面：{ name: 'a11y_share_start', data: { script } }
+/// 只接受無障礙輔助網頁（A11yShareService.serviceUrl）送來的訊息，回覆 true／false。
+class A11yShareStartMessageHandler extends TPWebMessageHandler {
+  @override
+  String get name => 'a11y_share_start';
+
+  @override
+  Future<void> handle({
+    required Object? message,
+    required WebUri? sourceOrigin,
+    required bool isMainFrame,
+    required Function(WebMessage replyWebMessage)? onReply,
+  }) async {
+    final A11yShareService service = A11yShareService.instance;
+    final Object? script = message is Map ? message['script'] : null;
+    if (!isMainFrame || !service.isTrustedOrigin(sourceOrigin) || script is! String || script.isEmpty) {
+      onReply?.call(replyWebMessage(data: false));
+      return;
+    }
+    service.start(script);
+    onReply?.call(replyWebMessage(data: true));
+  }
+}
+
+/// 停止分享：{ name: 'a11y_share_stop' }。被照顧者按「停止分享」或分享已結束時，
+/// 分享程式會從服務網頁送出，所以任何網頁都可以要求停止。
+class A11yShareStopMessageHandler extends TPWebMessageHandler {
+  @override
+  String get name => 'a11y_share_stop';
+
+  @override
+  Future<void> handle({
+    required Object? message,
+    required WebUri? sourceOrigin,
+    required bool isMainFrame,
+    required Function(WebMessage replyWebMessage)? onReply,
+  }) async {
+    A11yShareService.instance.stop();
+    onReply?.call(replyWebMessage(data: true));
+  }
+}
