diff --git a/test/a11y_share_test.dart b/test/a11y_share_test.dart
new file mode 100644
index 0000000..fe68097
--- /dev/null
+++ b/test/a11y_share_test.dart
@@ -0,0 +1,244 @@
+import 'package:flutter/material.dart';
+import 'package:flutter_inappwebview/flutter_inappwebview.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:get/get.dart';
+import 'package:town_pass/service/a11y_share_service.dart';
+import 'package:town_pass/util/a11y_share_scope.dart';
+
+/// 無障礙輔助「讓家人幫忙」：分享整個 App 的畫面、家人遠端點按與打字。
+/// 不連線（connectEnabled = false），直接呼叫 runCommand 模擬家人送來的指令。
+void main() {
+  final A11yShareService service = A11yShareService.instance;
+
+  setUp(() => service.connectEnabled = false);
+  tearDown(service.stop);
+
+  final List<String> pressed = [];
+  final TextEditingController name = TextEditingController();
+  final TextEditingController password = TextEditingController();
+  final ScrollController scroll = ScrollController();
+
+  Widget app() {
+    pressed.clear();
+    name.clear();
+    password.clear();
+    return GetMaterialApp(
+      builder: (context, child) => A11yShareScope(child: child ?? const SizedBox.shrink()),
+      home: Scaffold(
+        body: ListView(
+          controller: scroll,
+          children: [
+            const _Counter(),
+            ElevatedButton(onPressed: () => pressed.add('next'), child: const Text('下一步')),
+            ElevatedButton(onPressed: () => pressed.add('submit'), child: const Text('送出申請')),
+            TextField(key: const Key('name'), controller: name, decoration: const InputDecoration(labelText: '姓名')),
+            TextField(key: const Key('password'), controller: password, obscureText: true, decoration: const InputDecoration(labelText: '密碼')),
+            ElevatedButton(
+              onPressed: () => Get.to(() => const Scaffold(body: Center(child: Text('第二頁')))),
+              child: const Text('打開第二頁'),
+            ),
+            for (int i = 0; i < 30; i++) SizedBox(height: 60, child: Text('第 $i 行')),
+          ],
+        ),
+      ),
+    );
+  }
+
+  void share() => service.start(token: 't1', caregiverName: '王小美', elderName: '王阿伯');
+
+  Offset center(WidgetTester tester, Finder finder) => tester.getCenter(finder);
+
+  Future<Map<String, Object?>> command(WidgetTester tester, Map<String, dynamic> command) async {
+    final Future<Map<String, Object?>> result = service.runCommand(command);
+    // 等點按做完，也等標示位置的圈消失（1.2 秒）
+    for (int i = 0; i < 30; i++) {
+      await tester.pump(const Duration(milliseconds: 50));
+    }
+    return result;
+  }
+
+  Future<Map<String, Object?>> tap(WidgetTester tester, Finder finder) {
+    final Offset point = center(tester, finder);
+    return command(tester, {'command_id': 'c1', 'action': 'tap', 'x': point.dx, 'y': point.dy});
+  }
+
+  testWidgets('沒有分享時畫面和原本一樣；開始分享後出現提示列，頁面不會重建', (tester) async {
+    await tester.pumpWidget(app());
+    expect(find.text('停止分享'), findsNothing);
+
+    await tester.tap(find.byKey(const Key('counter')));
+    await tester.pump();
+    expect(find.text('按了 1 次'), findsOneWidget);
+
+    share();
+    await tester.pump();
+    expect(find.text('王小美 正在看你的畫面'), findsOneWidget);
+    expect(find.text('停止分享'), findsOneWidget);
+    expect(find.text('按了 1 次'), findsOneWidget, reason: '開始分享不能讓 App 的頁面重來');
+  });
+
+  testWidgets('拍下整個 App 的畫面（不含提示列）', (tester) async {
+    await tester.pumpWidget(app());
+    share();
+    await tester.pump();
+
+    final Map<String, Object?>? frame = await tester.runAsync<Map<String, Object?>?>(() => service.captureFrame(waitForFrame: false));
+    expect(frame, isNotNull);
+    expect(frame!['type'], 'frame');
+    expect(frame['image'] as String, startsWith('data:image/png;base64,'));
+    expect(frame['width'], 800.0);
+    expect(frame['height'], lessThan(600.0), reason: '提示列不在拍下的畫面裡');
+    expect(frame['overlays'], isEmpty);
+  });
+
+  testWidgets('家人點一般按鈕：直接按', (tester) async {
+    await tester.pumpWidget(app());
+    share();
+    await tester.pump();
+
+    final Map<String, Object?> result = await tap(tester, find.text('下一步'));
+    expect(result, {'type': 'result', 'command_id': 'c1', 'ok': true, 'message': '已按下「下一步」。'});
+    expect(pressed, ['next']);
+  });
+
+  testWidgets('家人點重要按鈕：先問長輩，不同意就不按，同意才按', (tester) async {
+    await tester.pumpWidget(app());
+    share();
+    await tester.pump();
+    final Offset point = center(tester, find.text('送出申請'));
+
+    Future<Map<String, Object?>> result = service.runCommand({'command_id': 'c2', 'action': 'tap', 'x': point.dx, 'y': point.dy});
+    await tester.pump();
+    expect(find.text('王小美 想幫你按「送出申請」，同意嗎？'), findsOneWidget);
+
+    // 問的時候家人的其他指令都不執行（也按不到「同意」）
+    final Map<String, Object?> blocked = await tap(tester, find.text('下一步'));
+    expect(blocked['ok'], false);
+    expect(blocked['message'], '正在等 王阿伯 回答，請稍等。');
+
+    await tester.tap(find.text('不同意'));
+    await tester.pump();
+    expect(await result, containsPair('message', '王阿伯 不同意按「送出申請」。'));
+    expect(pressed, isEmpty);
+
+    result = service.runCommand({'command_id': 'c3', 'action': 'tap', 'x': point.dx, 'y': point.dy});
+    await tester.pump();
+    await tester.tap(find.text('同意'));
+    for (int i = 0; i < 30; i++) {
+      await tester.pump(const Duration(milliseconds: 50));
+    }
+    expect(await result, containsPair('message', '王阿伯 同意了，已按下「送出申請」。'));
+    expect(pressed, ['submit']);
+  });
+
+  testWidgets('家人幫忙打字：先點欄位再填；密碼欄位不能填', (tester) async {
+    await tester.pumpWidget(app());
+    share();
+    await tester.pump();
+
+    final Map<String, Object?> none = await command(tester, {'command_id': 'c4', 'action': 'type', 'value': '王大明'});
+    expect(none['ok'], false);
+
+    await tap(tester, find.byKey(const Key('name')));
+    final Map<String, Object?> typed = await command(tester, {'command_id': 'c5', 'action': 'type', 'value': '王大明'});
+    expect(typed['message'], '已填好「姓名」。');
+    expect(name.text, '王大明');
+
+    await tap(tester, find.byKey(const Key('password')));
+    final Map<String, Object?> blocked = await command(tester, {'command_id': 'c6', 'action': 'type', 'value': '1234'});
+    expect(blocked['ok'], false);
+    expect(blocked['message'], '密碼請 王阿伯 自己輸入。');
+    expect(password.text, isEmpty);
+  });
+
+  testWidgets('家人往下捲、回上一頁、回到首頁', (tester) async {
+    await tester.pumpWidget(app());
+    share();
+    await tester.pump();
+
+    final Map<String, Object?> scrolled = await command(tester, {'command_id': 'c7', 'action': 'scroll', 'dy': 300});
+    expect(scrolled['message'], '已往下捲。');
+    expect(scroll.offset, greaterThan(100));
+    scroll.jumpTo(0);
+    await tester.pump();
+
+    await tap(tester, find.text('打開第二頁'));
+    await tester.pumpAndSettle();
+    expect(find.text('第二頁'), findsOneWidget);
+
+    final Map<String, Object?> back = await command(tester, {'command_id': 'c8', 'action': 'back'});
+    await tester.pumpAndSettle();
+    expect(back['message'], '已回到上一頁。');
+    expect(find.text('第二頁'), findsNothing);
+
+    // 回到首頁：關掉疊在上面的所有頁面
+    await tap(tester, find.text('打開第二頁'));
+    await tester.pumpAndSettle();
+    final Map<String, Object?> home = await command(tester, {'command_id': 'c9', 'action': 'home'});
+    await tester.pumpAndSettle();
+    expect(home['message'], '已回到台北通首頁。');
+    expect(find.text('第二頁'), findsNothing);
+    expect((await command(tester, {'command_id': 'c10', 'action': 'home'}))['message'], '已經在台北通首頁了。');
+  });
+
+  testWidgets('長輩剛按「同意」：回到台北通首頁；重新打開無障礙輔助（同一個 token）不會被關掉', (tester) async {
+    await tester.pumpWidget(app());
+    await tester.tap(find.text('打開第二頁')); // 代表長輩正在看的無障礙輔助頁
+    await tester.pumpAndSettle();
+    expect(find.text('第二頁'), findsOneWidget);
+
+    service.start(token: 't1', caregiverName: '王小美', elderName: '王阿伯', goHome: true);
+    await tester.pumpAndSettle();
+    expect(find.text('第二頁'), findsNothing);
+
+    await tester.tap(find.text('打開第二頁'));
+    await tester.pumpAndSettle();
+    service.start(token: 't1', caregiverName: '王小美', elderName: '王阿伯', goHome: true);
+    await tester.pumpAndSettle();
+    expect(find.text('第二頁'), findsOneWidget);
+  });
+
+  testWidgets('長輩按「停止分享」：先確認，確定後結束', (tester) async {
+    await tester.pumpWidget(app());
+    share();
+    await tester.pump();
+
+    await tester.tap(find.text('停止分享'));
+    await tester.pump();
+    expect(find.text('確定不讓 王小美 看你的畫面了嗎？'), findsOneWidget);
+    await tester.tap(find.text('取消'));
+    await tester.pump();
+    expect(service.active, isTrue);
+
+    await tester.tap(find.text('停止分享'));
+    await tester.pump();
+    await tester.tap(find.text('確定停止'));
+    await tester.pump();
+    expect(service.active, isFalse);
+    expect(find.text('停止分享'), findsNothing);
+  });
+
+  test('只接受無障礙輔助網頁送來的開始分享', () {
+    // 測試沒有指定 A11Y_URL，預設是 https://a11y.invalid/
+    expect(service.isTrustedOrigin(null), isFalse);
+    expect(service.isTrustedOrigin(WebUri('https://a11y.invalid')), isTrue);
+    expect(service.isTrustedOrigin(WebUri('https://evil.example')), isFalse);
+    expect(service.isTrustedOrigin(WebUri('http://a11y.invalid')), isFalse);
+  });
+}
+
+class _Counter extends StatefulWidget {
+  const _Counter();
+
+  @override
+  State<_Counter> createState() => _CounterState();
+}
+
+class _CounterState extends State<_Counter> {
+  int count = 0;
+
+  @override
+  Widget build(BuildContext context) {
+    return TextButton(key: const Key('counter'), onPressed: () => setState(() => count++), child: Text('按了 $count 次'));
+  }
+}
