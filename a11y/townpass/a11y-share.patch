@@ -0,0 +1,56 @@
+import 'package:flutter_inappwebview/flutter_inappwebview.dart';
+import 'package:town_pass/service/a11y_share_service.dart';
+import 'package:town_pass/util/web_message_handler/tp_web_message_handler.dart';
+
+/// 無障礙輔助網頁開始分享畫面：
+/// { name: 'a11y_share_start', data: { token, caregiver_name, elder_name } }
+/// 長輩同意後送出，之後家人看得到台北通的所有畫面。
+/// 只接受無障礙輔助網頁（A11yShareService.serviceUrl）送來的訊息，回覆 true／false。
+class A11yShareStartMessageHandler extends TPWebMessageHandler {
+  @override
+  String get name => 'a11y_share_start';
+
+  @override
+  Future<void> handle({
+    required Object? message,
+    required WebUri? sourceOrigin,
+    required bool isMainFrame,
+    required Function(WebMessage replyWebMessage)? onReply,
+  }) async {
+    final A11yShareService service = A11yShareService.instance;
+    final String? token = _text(message, 'token');
+    final String? caregiverName = _text(message, 'caregiver_name');
+    final String? elderName = _text(message, 'elder_name');
+    if (!isMainFrame || !service.isTrustedOrigin(sourceOrigin) || token == null || caregiverName == null || elderName == null) {
+      onReply?.call(replyWebMessage(data: false));
+      return;
+    }
+    // go_home：長輩剛按「同意」，關掉無障礙輔助回到台北通首頁，家人直接操作台北通
+    final bool goHome = message is Map && message['go_home'] == true;
+    service.start(token: token, caregiverName: caregiverName, elderName: elderName, goHome: goHome);
+    onReply?.call(replyWebMessage(data: true));
+  }
+
+  String? _text(Object? message, String key) {
+    final Object? value = message is Map ? message[key] : null;
+    return value is String && value.isNotEmpty && value.length <= 100 ? value : null;
+  }
+}
+
+/// 停止分享：{ name: 'a11y_share_stop' }。分享結束時無障礙輔助網頁會送出。
+/// 停止不會造成危險，所以任何網頁都可以要求停止。
+class A11yShareStopMessageHandler extends TPWebMessageHandler {
+  @override
+  String get name => 'a11y_share_stop';
+
+  @override
+  Future<void> handle({
+    required Object? message,
+    required WebUri? sourceOrigin,
+    required bool isMainFrame,
+    required Function(WebMessage replyWebMessage)? onReply,
+  }) async {
+    A11yShareService.instance.stop();
+    onReply?.call(replyWebMessage(data: true));
+  }
+}
